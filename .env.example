# TaskFlow Environment Variables
# Copy this file to .env for local adjustments

# Application
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8085

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow

# Worker Engine Configuration
TASKFLOW_WORKER_POOL_SIZE=6
TASKFLOW_SCHEDULER_POLL_INTERVAL_MS=500
TASKFLOW_SCHEDULER_BATCH_SIZE=10
TASKFLOW_SCHEDULER_LEASE_TIMEOUT_SECONDS=120
TASKFLOW_RETRY_INITIAL_DELAY_SECONDS=2
TASKFLOW_RETRY_MAX_DELAY_SECONDS=60
TASKFLOW_RETRY_MAX_ATTEMPTS=3

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8085
PORT=5173
